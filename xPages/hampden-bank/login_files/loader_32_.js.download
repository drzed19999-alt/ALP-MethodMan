
define('text!framework/elements/api/obdx-widget/obdx-widget.html',[],function () { return '<div class="oj-flex oj-sm-flex-direction-column oj-sm-padding-6x-vertical full-height obdx-widget"><div class="obdx-widget__header"><div class="oj-sm-padding-6x-horizontal oj-sm-padding-6x-bottom"><div class="oj-flex-bar oj-sm-align-items-center"><div class="oj-flex-bar-start"><h4><oj-bind-text value="[[$properties.heading]]"></oj-bind-text></h4></div><div class="oj-flex-bar-end"><oj-bind-slot name="header"></oj-bind-slot></div></div><oj-bind-if test="[[$properties.description]]"><div class="oj-typography-subheading-xs oj-sm-padding-2x-top"><oj-bind-text value="[[$properties.description]]"></oj-bind-text></div></oj-bind-if></div></div><oj-bind-if test="[[!$properties.noDataApplicable]]"><oj-bind-if test="[[$slotCounts.body]]"><div class="obdx-widget__body"><div class="oj-sm-padding-6x-horizontal"><oj-bind-slot name="body"></oj-bind-slot></div></div></oj-bind-if><oj-bind-if test="[[$slotCounts.footer]]"><div class="obdx-widget__footer"><div class="oj-sm-padding-6x-horizontal oj-sm-padding-2x-top"><oj-bind-slot name="footer"></oj-bind-slot></div></div></oj-bind-if></oj-bind-if><oj-bind-if test="[[$properties.noDataApplicable]]"><oj-bind-if test="[[$slotCounts.noData]]"><div class="oj-sm-padding-6x-horizontal"><oj-bind-slot name="noData"></oj-bind-slot></div></oj-bind-if></oj-bind-if></div>';});


define('text!framework/elements/api/obdx-widget/component.json',[],function () { return '{\r\n  "name": "obdx-widget",\r\n  "version": "1.0.0",\r\n  "jetVersion": "^13.0.0",\r\n  "displayName": "Framework Composite Component",\r\n  "description": "Framework Composite Component",\r\n  "properties": {\r\n    "heading": {\r\n      "description": "Widget Heading",\r\n      "type": "string",\r\n      "translatable":true\r\n    },\r\n    "description": {\r\n      "description": "Widget Description",\r\n      "type": "string"\r\n    },\r\n    "noDataApplicable": {\r\n      "description": "It is used to identify if data is available for the widget or not",\r\n      "type": "boolean",\r\n      "value": false\r\n    }\r\n  },\r\n  "slots": {\r\n    "header":{\r\n      "description": "Associated actions/content will be displayed on top right section (beside widget heading) of the widget"\r\n    },\r\n    "body":{\r\n      "description": "It will have the main content of the widget"\r\n    },\r\n    "footer":{\r\n      "description": "Associated actions/content will be displayed on bottom of the widget"\r\n    },\r\n    "noData":{\r\n      "description": "It will contain alternative data in absence of main data"\r\n    }\r\n  },\r\n  "methods": {},\r\n  "events": {}\r\n}\r\n';});


define('text!framework/elements/api/obdx-widget/obdx-widget.css',[],function () { return '.obdx-widget-container .obdx-widget{padding:0}.obdx-widget-container .obdx-widget__body{min-height:1rem;flex:1;overflow:auto;width:100%;--oj-list-view-item-padding-horizontal:0}';});

define('framework/elements/api/obdx-widget/loader',["ojs/ojcomposite","module","text!./obdx-widget.html","text!./component.json","text!./obdx-widget.css","base-models/css"],function(e,t,o,s,d,m){"use strict";e.register("obdx-widget",{view:m.transformTemplate(o,d,m.getComponentName(t)),metadata:JSON.parse(s)})});
