define('text!components/widgets/pre-login/bank-products/bank-products.css',[],function () { return '.bank-products-container .product-quick-links_card{border-radius:3%;width:15rem;height:14rem;background:var(--oj-panel-bg-color);margin:0 .5rem}.bank-products-container .product-quick-links .icon-container{border-radius:50%}.bank-products-container .product-quick-links .icon-container:hover{box-shadow:0 0 5px 5px rgba(0,0,0,.07);background-color:var(--oj-panel-bg-color);transition:.2s linear}.bank-products-container .know-more-link{position:absolute;bottom:1rem}.bank-products-container .card-text{color:var(--button-primary-foreground-color)}.bank-products-container .bundle-card{border-radius:.5rem;cursor:pointer;background-color:var(--graph-color4);border:1px solid var(--buttonset-border-color);color:var(--oj-panel-bg-color)}.bank-products-container .apptracker-card{border-radius:.5rem;cursor:pointer;background-color:var(--graph-color10);padding:2rem .6rem;color:var(--oj-panel-bg-color)}.bank-products-container .placeholder{color:var(--oj-panel-bg-color)}.bank-products-container .colorPlaceholder{width:100%}.bank-products-container .bundle_padding{padding:2.5rem 0 0;margin:0 0 0 13.5rem}.bank-products-container .product-quick-links-flex-container-medium{list-style:none;padding:0}.bank-products-container .spaceEvenly{justify-content:space-evenly}.bank-products-container .placeholder-align{margin:30% 4%}.bank-products-container .placeholder-color{color:var(--oj-panel-bg-color)}.bank-products-container .placeholder-content{font-size:var(--oj-typography-body-xl-font-size);font-weight:600}.bank-products-container .bundleFont{font-size:var(--oj-typography-body-sm-font-size)}[dir=ltr] .bank-products-container .bundleSpace,[dir=rtl] .bank-products-container .bundleSpace{margin-top:.8rem}.bank-products-container .bundle_margin_lg{margin:0 0 0 2rem}.bank-products-container .box_mobile{border:1px solid var(--oj-core-divider-color);border-radius:.5rem;height:14rem;position:relati