
define('text!framework/elements/api/row/row.html',[],function () { return '<!-- ko ifnot: appData.appData.segment ===\'ADMIN\' ||  appData.appData.segment ===\'CORPADMIN\' --><oj-text-area label-hint="[[$properties.label]]" label-edge="inside" class="obdx-row-min-width" :class="[[customClasses]]" value="{{!Array.isArray(ko.utils.unwrapObservable($properties.value)) ? $properties.value : unwrapValues(ko.utils.unwrapObservable($properties.value)) }}" max-rows="-1" readonly="readonly"></oj-text-area><!-- /ko --><!-- ko if: appData.appData.segment ===\'ADMIN\' || appData.appData.segment ===\'CORPADMIN\' --><oj-label-value label-edge="start" label-width="25%"><oj-label slot="label"><oj-bind-text value="[[$properties.label]]"></oj-bind-text></oj-label><oj-text-area slot="value" value="{{!Array.isArray(ko.utils.unwrapObservable($properties.value)) ? $properties.value : unwrapValues(ko.utils.unwrapObservable($properties.value)) }}" class="obdx-row-min-width" :class="[[customClasses]]" max-rows="-1" readonly="readonly"></oj-text-area></oj-label-value><!-- /ko -->';});

define('framework/elements/api/row/row',["knockout","framework/js/app-data","ojs/ojinputtext","ojs/ojlabelvalue"],function(s,t){"use strict";return function(e){this.appData=t,this.customClasses=s.observable();const o=[];this.unwrapValues=function(t){const e=[];for(let o=0;o<t.length;o++)s.utils.unwrapObservable(t[o])&&e.push(s.utils.unwrapObservable(t[o]));return e.join("\n")},e.properties.size&&o.push(`oj-typography-body-${e.properties.size}`),e.properties.type&&o.push(`oj-text-color-${e.properties.type}`),this.customClasses(o.join(" "))}});

define('text!framework/elements/api/row/component.json',[],function () { return '{\r\n    "name": "obdx-row",\r\n    "version": "1.0.0",\r\n    "jetVersion": "^8.1.0",\r\n    "displayName": "Framework Composite Component",\r\n    "description": "Framework Composite Component",\r\n    "properties": {\r\n        "label": {\r\n            "description": "Label",\r\n            "type": "string",\r\n            "required": true,\r\n            "translatable": true\r\n        },\r\n        "value": {\r\n            "description": "Value",\r\n            "type": "Array|string|number",\r\n            "required": true\r\n        },\r\n        "dataId": {\r\n            "description": "Class",\r\n            "type": "string"\r\n        },\r\n        "size": {\r\n            "description": "Size of Text",\r\n            "type": "string"\r\n        },\r\n        "type": {\r\n            "description": "Type",\r\n            "type": "string"\r\n        }\r\n    },\r\n    "methods": {},\r\n    "events": {},\r\n    "slots": {}\r\n}';});

define('framework/elements/api/row/loader',["ojs/ojcomposite","text!./row.html","./row","text!./component.json"],function(e,o,t,i){"use strict";e.register("obdx-row",{view:o,viewModel:t,metadata:JSON.parse(i)})});
