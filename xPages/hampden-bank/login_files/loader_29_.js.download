rams="{{{rootModel:$data,type:alternateLogin()}}}"></alternate-login><!-- /ko --></div></div><!-- /ko --><!-- ko ifnot:landingComponent --><!-- ko if:domUtil.cordovaDevice() --><!-- ko if:showAccountSnapshot() --><div class="oj-sm-margin-4x-vertical oj-flex oj-sm-flex-items-initial oj-sm-justify-content-space-between oj-sm-align-items-center"><!-- ko if:showAlternateLogin() --><alternate-login params="{{{rootModel:$data,type:alternateLogin()}}}"></alternate-login><!-- /ko --><!-- ko if:alternateLogin() --><!-- /ko --><!-- ko if:showAlternativeSwitch() --><!-- /ko --></div><!-- /ko --><!-- /ko --><div class="logorow"><img class="fscsLogoMobile" data-bind="loadImage:\'common/fscsIcon.png\'"> <img class="fraudLogoMobile" data-bind="loadImage:\'common/takeFive.jpg\'"/></div><!-- /ko --></div></div></div><!-- /ko --><!-- ko if: domUtil.cordovaDevice()==="ANDROID"--><modal-window class="message form-main-container" dialog-id="[[\'customPopupforPushNotification\']]" header="[[nls.loginForm.labels.push_window_title]]" close-handler="[[closeHandler]]" modal-window-ready="[[showDialog]]"><div class="oj-flex oj-flex-items-pad"><div class="oj-flex-item oj-sm-12"><span data-bind="text:nls.loginForm.labels.push_window_message"></span></div><div class="message-btn button-container oj-flex-bar-middle confirm-dialog-container__button"><div class="oj-flex-item center oj-lg-10 oj-md-10"><oj-button class="form-button-primary" on-click="[[enablePush]]"><span data-bind="text:nls.loginForm.labels.allow"></span></oj-button><oj-button class="form-button-secondary" on-click="[[disablePush]]"><span data-bind="text:nls.loginForm.labels.disallow"></span></oj-button></div></div></div></modal-window><!-- /ko --><!-- ko if: domUtil.cordovaDevice() --><modal-window class="favorite-container" dialog-id="[[\'exitModal\']]" header="[[nls.loginForm.labels.exitApplication]]" close-handler="[[closeModal]]"><div><div class="oj-flex oj-flex-items-pad"><div class="oj-flex-item oj-sm-12" data-bind="text:nls.loginForm.labels.exitModal"></div></div><div class="button-container"><oj-button class="action-button-primary" chroming="callToAction" on-click="[[exitApplication]]"><span data-bind="text:nls.loginForm.labels.yes"></span></oj-button><oj-button class="action-button-secondary" chroming="solid" on-click="[[closeModal]]"><span data-bind="text:nls.loginForm.labels.no"></span></oj-button></div></div></modal-window><modal-window class="favorite-container" dialog-id="[[\'firstTimeLoginNotCompleted\']]" header="[[nls.loginForm.labels.sinceYouAreNewUser]]" close-handler="[[goToLoginPage]]"><div><div class="oj-flex-items-pad"><div data-bind="text:nls.loginForm.labels.sinceYouAreNewUser"></div></div><div class="button-container"><oj-button class="action-button-secondary" chroming="solid" on-click="[[goToLoginPage]]"><span data-bind="text:nls.loginForm.labels.ok"></span></oj-button></div></div></modal-window><!-- /ko --><!-- /ko --></oj-bind-if><oj-bind-if test="[[showPartialPage()]]"><!-- ko template:{name: \'login/logout\'} --><!-- /ko --></oj-bind-if>';});

