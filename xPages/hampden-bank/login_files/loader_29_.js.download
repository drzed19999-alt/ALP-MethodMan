define('text!extensions/components/login/login-form-web/login-form-web.css',[],function () { return '.login-form-web-container .login-web-container{top:0;width:100vw;background-color:#443d66;background-repeat:no-repeat;background-size:cover;height:100vh;z-index:5;position:fixed;align-items:center;justify-content:center}[dir=rtl] .login-form-web-container .login-web-container{right:0}[dir=ltr] .login-form-web-container .login-web-container{left:0}.login-form-web-container .login-web-container .login-panel{background:rgba(var(--oj-palette-neutral-rgb-170),.7);--oj-text-field-bg-color:rgba(var(--oj-palette-neutral-rgb-140), .9);border-radius:20px;background-color:#dcdcef;left:2%}.login-form-web-container .loginContainer .loginFormContainer .login-logo{background-color:var(--base-color-secondary);text-align:center;padding:.5rem 1rem}.login-form-web-container .loginContainer .loginFormContainer .login-logo img{width:12.5rem}.login-form-web-container .loginContainer .loginFormContainer input[type=password],.login-form-web-container .loginContainer .loginFormContainer input[type=text]{padding:0 0 0 1.9rem!important}[dir=rtl] .login-form-web-container .loginContainer .loginFormContainer input[type=password],[dir=rtl] .login-form-web-container .loginContainer .loginFormContainer input[type=text]{padding:0 1.9rem 0 0!important}.login-form-web-container .loginContainer .loginFormContainer .icons{position:absolute;margin:.3rem;z-index:2}.login-form-web-container .loginContainer .loginFormContainer .row{padding:.5rem .6rem}.login-form-web-container .danger{color:var(--base-color-danger)}.login-form-web-container .login-enclosure .loginButton{width:225px;margin:.6rem 0}.login-form-web-container .login-enclosure__seperator{padding:0 .3rem}.login-form-web-container .login-enclosure .alternate-login-lbl{margin-top:.5rem}.login-form-web-container .scamWarningTxtMobile{font-size:11px;line-height:1.5;color:#485d89;text-align:center;margin:8px auto 0;width:300px;position:relative;left:5