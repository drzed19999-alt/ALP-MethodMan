
define('text!extensions/components/login/login-form-web/login-form-web.html',[],function () { return '<oj-bind-if test="[[!isLogoutMobile()]]"><!-- ko if: isPushoobAllowed() && notificationDataFetched() --><h4 class="center" data-bind="text: nls.loginForm.labels.authenticate"></h4><img class="authenticationImage" data-bind="loadImage : \'authentication/authentication.svg\'"><div class="oj-flex-item authenticate"><div class="oj-flex-items-pad quickSnapshotLinkFont" data-bind="text:nls.loginForm.labels.authenticateText"></div></div><div class="oj-flex-items-pad"><!-- ko foreach: displayData() --><obdx-row label="[[$data.key]]" value="[[$data.key === \'Amount\' ? $parents[$parents.length-1].formatter.getDomFormatter.formatCurrency($data.value.amount, $data.value.currency) : $data.value]]"></obdx-row><!-- /ko --></div><div class="oj-flex oj-flex-items-pad button-container"><oj-button class="action-button-primary" chroming="callToAction" display="icons" on-click="[[accept]]"><span class="icons oj-ux-ico-check-circle"></span><span data-bind="text:nls.loginForm.labels.confirm"></span></oj-button><oj-button class="action-button-secondary" chroming="solid" display="icons" on-click="[[reject]]"><span class="icons oj-ux-ico-close-circle"></span><span data-bind="text:nls.loginForm.labels.cancel"></span></oj-button></div><!-- /ko --><!-- ko ifnot: domUtil.cordovaDevice() --><!-- ko ifnot: isPushoobAllowed() --><div class="oj-flex login-web-container oj-color-invert"><div class="oj-panel oj-sm-padding-0 login-panel"><!-- ko if: loading() --><oj-progress-bar class="oj-progress-bar-embedded" value="-1"></oj-progress-bar><!-- /ko --><div class="oj-sm-padding-6x"><div class="icon-logo center oj-sm-padding-6x-bottom"><div class="oj-sm-margin-4x-top oj-sm-margin-3x-bottom"><h1 class="welcomeTxt" data-bind="text:nls.loginForm.labels.welcome"></h1><p class="scamWarningTxt" data-bind="text:nls.loginForm.labels.scamText"></p></div></div><div class="oj-text-color-danger center message-container" data-bind="css: { \'message-hidden\': !message(), \'message-visible\': message() }"><span data-bind="text:message"></span></div><oj-input-text class="oj-flex oj-sm-padding-2x" id="username" value="{{username}}" label-hint="[[nls.loginForm.labels.username]]" label-edge="inside"></oj-input-text><oj-input-password class="oj-flex oj-sm-padding-2x" id="password" mask-icon="visible" value="{{password}}" label-hint="[[nls.loginForm.labels.password]]" label-edge="inside"></oj-input-password><oj-button id="login-button" class="oj-button-lg cz-login-button oj-sm-margin-6x-top" chroming="callToAction" on-click="[[onLogin]]"><span class="labelColor" data-bind="text:nls.loginForm.labels.login"></span></oj-button><!-- ko ifnot:landingComponent && domUtil.cordovaDevice()--><div class="forgetPanel oj-sm-margin-4x-bottom oj-sm-margin-4x-top center"><span data-bind="text:nls.loginForm.labels.forgot"></span> <a href="#" data-bind="text:nls.loginForm.labels.username,\n                  click:forgotUserId.bind($data) ,attr:{alt: nls.forgotUserIdClick,title: nls.forgotUserIdTitle}"></a> <span data-bind="text:nls.loginForm.labels.or"></span> <a href="#" data-bind="text:nls.loginForm.labels.pwd,\n           click:forgotPass.bind(ko.contextFor(document.body).$data) ,attr:{alt: nls.forgotPasswordClick, title: nls.forgotPasswordTitle}"></a> <span data-bind="text:nls.loginForm.labels.questionMark"></span></div><!-- /ko --><!-- ko if:domUtil.cordovaDevice() && showLoginOptions() --><!-- /ko --><!-- ko if:landingComponent && alternateLogin() && landingComponent==="scan-to-pay" && domUtil.cordovaDevice() --><div class="oj-sm-margin-10x-top oj-divider-top"><div class="oj-sm-margin-8x-vertical center"><div class="oj-flex-item alternateLoginLink"><a href="#" data-bind="click:openAlternateLogin"><span class="oj-flex-items-pad" data-bind="text:domUtil.format(nls.loginForm.labels.loginVia,{type:nls.loginForm.labels[alternateLogin().split(\'-\')[0]]})"></span></a></div><!-- ko if:showAlternateLogin() --><alternate-login params="{{{rootModel:$data,type:alternateLogin()}}}"></alternate-login><!-- /ko --></div></div><!-- /ko --><!-- ko ifnot:landingComponent --><!-- ko if:domUtil.cordovaDevice() --><!-- ko if:showAccountSnapshot() --><div class="oj-sm-margin-4x-vertical oj-flex oj-sm-flex-items-initial oj-sm-justify-content-space-between oj-sm-align-items-center"><!-- ko if:showAlternateLogin() --><alternate-login params="{{{rootModel:$data,type:alternateLogin()}}}"></alternate-login><!-- /ko --><!-- ko if:alternateLogin() --><div class="oj-flex-item alternateLoginLink"><a href="#" data-bind="click:openAlternateLogin"><span class="oj-flex-items-pad" data-bind="text:domUtil.format(nls.loginForm.labels.loginVia,{type:nls.loginForm.labels[alternateLogin().split(\'-\')[0]]})"></span></a></div><!-- /ko --><!-- ko if:showAlternativeSwitch() --><!-- /ko --></div><!-- /ko --><!-- /ko --><div class="logorow"><img class="fscsLogo" data-bind="loadImage:\'common/fscsIcon.png\'"> <img class="fraudLogo" data-bind="loadImage:\'common/takeFive.png\'"/></div><!-- /ko --></div></div><div class="loginFooter"><obdx-footer></obdx-footer></div></div><!-- /ko --><!-- /ko --><!-- ko if: domUtil.cordovaDevice()--><!-- ko ifnot: isPushoobAllowed() --><div class="oj-flex login-mobile-container oj-color-invert"><div class="oj-panel oj-sm-padding-0 login-panel"><!-- ko if: loading() --><oj-progress-bar class="oj-progress-bar-embedded" value="-1"></oj-progress-bar><!-- /ko --><div class="oj-sm-padding-6x"><div class="icon-logo oj-sm-padding-3x-bottom center oj-sm-margin-1x-bottom marginTop6X"><div class="welcomeDivMobile"><h1 class="welcomeTxt" data-bind="text:nls.loginForm.labels.welcomeMobile"></h1><p class="scamWarningTxtMobile" data-bind="text:nls.loginForm.labels.scamText"></p></div></div><div class="oj-text-color-danger center message-container-mobile" data-bind="css: { \'message-hidden\': !message(), \'message-visible\': message() }"><span data-bind="text:message"></span></div><oj-i