
define('text!components/approvals/resolve-workflow/resolve-workflow.html',[],function () { return '<!-- ko if : $data.checkReroute() && !groupReroute() --><div class="oj-sm-padding-5x"><span data-bind="text : nls.selectRuleToReroute" class="oj-divider-end oj-sm-padding-3x-end"></span><prioritize-transaction prioritized="[[$data.prioritized()]]" transaction-id="[[$properties.params.rootModel.trnxId]]"></prioritize-transaction></div><!-- /ko --><!-- ko if : dataLoaded --><div class="rule-main-content"><oj-list-view id="listview" :aria-label="[[nls.ruleList]]" data="[[dataProvider]]" selection-mode="single" selected="{{selectedRule}}" on-selected-changed="[[handleSelectedChanged]]" class="list-view-scroll"><template slot="itemTemplate" data-oj-as="item"><li><oj-list-item-layout><div class="oj-flex-bar"><div class="oj-panel oj-flex-bar-start workflow-rule-container oj-bg-info-30 no-shadow"><div class="oj-header-border oj-sm-margin-2x-bottom"><div data-bind="text : $current.data.ruleName"></div><div class="oj-typography-body-2xs" data-bind="text : $current.data.amountRange"></div></div><!-- ko if : $current.data.imgPath --> <img class="img-class" data-bind="attr:{\'alt\':$current.data.imgAlt ,\'title\':$current.data.imgTitle },loadImage:$current.data.imgPath"/><!-- /ko --></div><div class="oj-flex-bar-middle"><oj-film-strip id="conveyorBelt" data-oj-binding-provider="none"><!-- ko foreach : $current.data.workflowDto.steps --><!-- ko if: userGroup.groupType === \'U\' --><!-- ko foreach:userGroup.users --><workflow-action-card params="{{{rootModel: $data, parentData : $parent, approvalType: $current.data.approvalType, workflowFor: $current.data.workflowFor }}}" class="oj-sm-margin-2x-horizontal"></workflow-action-card><!-- /ko --><!-- /ko --><!-- ko ifnot: userGroup.groupType === \'U\' --><workflow-action-card params="{{{rootModel: userGroup,parentData : $data, approvalType: $current.data.approvalType, workflowFor: $current.data.workflowFor }}}" class="oj-sm-margin-2x-horizontal"></workflow-action-card><!-- /ko --><!-- /ko --></oj-film-strip></div></div></oj-list-item-layout></li></template></oj-list-view></div><!-- ko if : resolveWorkflowArr.length > 0 --><div class="button-container"><oj-button class="action-button-primary" chroming="callToAction" id="submitbtn" on-click="[[confirm]]"><span data-bind="text: !$data.checkReroute() || $data.resolveGroup ? nls.assign : nls.reroute"></span></oj-button></div><!-- /ko --><!-- /ko -->';});

