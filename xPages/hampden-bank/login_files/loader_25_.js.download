
define('text!extensions/components/login/login-options/login-options.html',[],function () { return '<!-- ko ifnot: domUtil.cordovaDevice() --><modal-window class="favorite-container" dialog-id="[[\'loginMethod\']]" header="[[resource.selectLoginMethod]]" close-handler="[[hideWarning]]" modal-window-ready="[[showLoginOptionsDialog]]"><div><!-- ko if:firstTimeLoginFlow() || firstLoginFlowThroughDashboard() --><div class="oj-flex-items-pad"><div data-bind="text:resource.doYouWishTosetupAltenateLogin"></div><div class="oj-flex-item oj-sm-12 oj-sm-margin-4x-vertical" data-bind="text:resource.stepsHeader"></div></div><!-- /ko --><!-- ko if: dataLoaded() --><div class="oj-flex-item oj-sm-12 oj-sm-margin-4x-vertical"><oj-label for="alternateloginoptions"><span data-bind="text:resource.alternateLoginInfo"></span></oj-label></div><oj-navigation-list class="product-quick-links" selection="{{selectedLoginType}}"><ul class="oj-flex oj-flex-items-pad product-quick-links-flex-container oj-sm-flex-wrap-nowrap"><!-- ko foreach:listItem --><li data-bind="attr: {id: id}" class="oj-flex-item oj-sm-4 product-quick-links-flex-container__listItems"><a href="#" data-bind="attr:{\'alt\':$parents[$parents.length-1].resource[id]  }"><img class="icons" data-bind="loadImage: $data.iconImage"><div class="icon-title" data-bind="text:$parents[$parents.length-1].resource[id]"></div></a></li><!-- /ko --></ul></oj-navigation-list><!-- ko if:firstTimeLoginFlow() --><div class="button-container"><oj-button class="action-button-secondary" chroming="solid" on-click="[[hideWarning]]"><span data-bind="text:resource.cancel"></span></oj-button></div><!-- /ko --><!-- /ko --><div class="button-container"><oj-button class="action-button-secondary" chroming="solid" on-click="[[hideWarning]]"><span data-bind="text:resource.skip"></span></oj-button></div></div></modal-window><!-- /ko -->';});

