define('text!extensions/components/login/login-options/login-options.css',[],function () { return '.login-options-container .product-quick-links h3{font-size:var(--base-font-size-largest);text-align:center;font-weight:400}.login-options-container .product-quick-links-flex-container{display:-moz-box;display:-ms-flexbox;display:flex;-webkit-justify-content:space-around;justify-content:space-around;width:100%;flex-flow:row wrap;-webkit-align-items:center;align-items:center;padding:0;margin:0 auto;list-style:none;flex-wrap:wrap}.login-options-container .product-quick-links-flex-container li{min-width:16.1rem;padding-bottom:1.9rem;text-align:center}.login-options-container .product-quick-links-flex-container__listItems{padding:1.3rem 0}.login-options-container .product-quick-links-flex-item{flex-grow:1;flex-shrink:0;flex-basis:2em;text-align:center;min-width:7.5rem;margin:0 0 1.3rem}.login-options-container .product-quick-links-flex-item:hover .icon-title,.login-options-container .product-quick-links-flex-item:hover .icons{color:var(--link-base-hover)}.login-options-container .product-quick-links .icon-title{-webkit-line-clamp:2;overflow:hidden;text-overflow:ellipsis;width:100%;font-size:1rem;margin-bottom:-.3rem;line-height:normal}.login-options-container .product-quick-links .icons{font-size:4.4rem;position:relative;width:4.4rem;height:4.4rem;background-size:cover}.login-options-container .product-quick-links .link-text{top:.6rem;position:relative}[dir=rtl] .login-options-container .product-quick-links .link-text{padding-right:1.9rem}[dir=ltr] .login-options-container .product-quick-links .link-text{padding-left:1.9rem}@media only screen and (min-width:768px) and (max-width:1023px){.login-options-container .product-quick-links-flex-container li{min-width:11.3rem;padding-bottom:1.9rem}.login-options-container .product-quick-links-flex-item{min-width:11.3rem}}@media only screen and (max-width:767px){.login-options-container .product-quick-links-flex-container li{min-width:4.4rem;padding-bottom:1.3rem}.login-options-container .product-quick-links .icon-title{font-size:.7rem}.login-options-container .product-quick-links .icons{width:calc(4.4rem - 1.9rem);height:calc(4.4rem - 1.9rem)}}';});

