
define('text!framework/elements/core/docked-menu/docked-menu.html',[],function () { return '<div class="docked-menu oj-applayout-fixed-bottom oj-sm-padding-2x-top"><div id="navbar" role="navigation" data-oj-context><!-- ko if: isDockedMenu() --><oj-conveyor-belt class="background_for_belt" arrow-visibility="hidden"><div class="oj-flex oj-color-invert oj-sm-width-full oj-sm-justify-content-space-between oj-sm-padding-1x"><!-- ko foreach : {data : navDataSourceArray }   --><oj-bind-if test="[[$parent.appData.userSegment === \'ANON\']]"><div class="oj-flex-item center"><!-- ko ifnot: $data.subMenuItems --><oj-button display="icons" chroming="borderless" class="oj-button-lg" on-oj-action="[[$parent.selectionChange.bind(null, $data)]]"><span slot="startIcon" :class="[[$data.icons]]"></span><oj-bind-text value="[[$parent.resource.labels[$data.name]]]"></oj-bind-text></oj-button><!-- /ko --><!-- ko if: $data.subMenuItems --><oj-menu-button display="icons" chroming="borderless" class="oj-button-lg"><span slot="endIcon" :class="[[$data.icons]]"></span><oj-bind-text value="[[$parent.resource.labels[$data.name]]]"></oj-bind-text><oj-menu slot="menu" on-oj-menu-action="[[$parent.selectionChange]]"><oj-bind-for-each data="[[$data.subMenuItems]]"><template><oj-option value="[[$current.data]]"><oj-bind-text value="[[$parentContext.$data.resource.labels[$current.data.id]]]"></oj-bind-text></oj-option></template></oj-bind-for-each></oj-menu></oj-menu-button><!-- /ko --></div></oj-bind-if><oj-bind-if test="[[$parent.appData.userSegment !== \'ANON\']]"><!-- ko ifnot: ($data.id === "mailbox") --><div class="oj-flex-item center"><oj-button display="icons" chroming="borderless" class="oj-button-lg cz-button" on-oj-action="[[$parent.selectionChange.bind(null, $data)]]"><span slot="startIcon" :class="[[`${$data.iconClass} ${$data.id===\'payee-list\'&&\'rotate-class\'}`]]"></span><oj-bind-text value="[[$parent.resource.labels[$data.name]]]"></oj-bind-text></oj-button><div class="txt_color" data-bind="text:$parent.resource.labels[$data.name]"></div></div><!-- /ko --><!-- ko if: (!$parent.domUtil.large() && ($parent.appData.isUserDataSet() && $parent.appShellProperties.isDashboard()) && $data.id === "mailbox") --><div class="oj-flex-item center"><oj-button id="mailbox-holder-mobile" display="icons" chroming="borderless" class="oj-button-lg" on-oj-action="[[$parent.openMailBox]]"><!-- ko if: $parent.totalMailboxCount() !== 0  --> <span slot="startIcon" class="oj-ux-ico-notification"><span class="oj-badge oj-badge-danger badge" data-bind="text : $parent.totalMailboxCount()"></span> </span><!-- /ko --><!-- ko if: $parent.totalMailboxCount() === 0  --> <span slot="startIcon" class="oj-ux-ico-notification"></span><!-- /ko --><oj-bind-text value="[[$parent.resource.labels[$data.name]]]"></oj-bind-text></oj-button></div><!-- /ko --></oj-bind-if><!-- /ko --></div></oj-conveyor-belt><modal-window class="favorite-container" dialog-id="[[\'askToEnableSanpshot\']]" header="[[resource.labels.enableSnapshot]]"><div class="oj-flex oj-flex-items-pad"><div class="oj-flex-item oj-sm-12" data-bind="[[resource.labels.close]]"></div></div></modal-window><!-- /ko --></div></div>';});

define('resources/nls/docked-menu',{root:{labels:{dashboard:"Home",trends:"Trends","scan-to-pay":"Scan to Pay","scan-qr":"Scan QR","scan-your-card":"Scan Your Card",enableSnapshot:"To use this feature please enable Quick Snapshot. Once enabled you can scan your card.",qrScanMessage:"Scan QR-code anytime to continue on mobile!",close:"Close",favorites:"Favorites","demand-deposits":"Accounts","term-deposits":"Term Deposit","payee-list":"Payments","theme-config":"Services","preview-brand-list":"Services","service-requests-track":"Services",loans:"Loans",logout:"Logout",mailbox:"Alerts",applyNow:"Apply Now","bank-products":"Products","application-mobile-tracker":"Track Your Application",calculators:"Calculators","switch-entity":"Switch Entity","change-language":"Change Language","claim-money":"Claim Money",help:"Help",locator:"ATM & Branch Locator",call:"Call Us"},clickHere:"Click here to go to {details}",navBarDescription:"Docked Menu Navigation Bar",expandDockedButton:"Click to View Options",notifications:"Click here for notifications",notificationAlt:"Notifications"},ar:!0,es:!0,pt:!0,fr:!0,cs:!0,sv:!0,en:!1,"en-us":!1,el:!0});


