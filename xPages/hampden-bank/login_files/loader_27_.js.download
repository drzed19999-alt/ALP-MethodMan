define('components/home/mobile-landing/mobile-landing',["framework/js/utils","framework/js/dom-util","framework/js/navigation","knockout","ojL10n!resources/nls/mobile-landing","./model","components/widgets/pre-login/bank-products/loader"],function(e,t,o,n,a,r){"use strict";return function(c){const i=c.properties.params,s=this;s.domUtil=t,n.utils.extend(s,i.rootModel),s.nls=a,s.renderModuleData=n.observable(!1),s.productTiles=n.observable(),s.selectedItem=n.observable("home"),e.registerComponent("claim-payment-dashboard","claim-payment"),e.registerComponent("bot-client","chatbot"),e.registerComponent("product-details","origination"),s.gohome=function(){s.selectedItem("home")},s.quickLinks=[{txt:s.nls.quickLinks.labels.products,icon:"ochat/chatbot_icon.png",link:"chatBot"}],s.onSelectClick=function(e){s.selectedItem(e.link),"chatBot"===e.link&&s.onChatBotClick(),"wallet"===e.link&&r.fetchWalletProducts("WALLETH1").then(function(e){s.productsData={selectedProduct:e.productDTOs[0],actionCardData:{category:e.productDTOs[0].productType,id:"WALLETH1",productClass:e.productDTOs[0].category}},o.loadComponent("product-details",{productsData:s.productsData})})},t.cordovaDevice()&&window.plugins.appPreferences.fetch("scan_to_pay_quick_action").then(function(t){window.plugins.appPreferences.remove("scan_to_pay_quick_action"),t&&(e.registerComponent("scan-qr","payments"),o.loadComponent("scan-qr",{landingModule:"payments",landingComponent:"scan-qr",hideMobileLanding:!0,optForAlternateLogin:!1,params:s}))}),s.renderModuleData(!0)}});

