define([],function(){"use strict";return{getUrlParams:function(e){if(null===e)return null;if(e.includes("reset-password")){const n=e.split("?")[1];if(n.length<0)return null;const t=new URLSearchParams(n),o={};return o.homeComponent=t.get("homeComponent"),o.homeModule=t.get("homeModule"),o.determinantvalue=t.get("determinantvalue"),o.token=t.get("token"),o}if(e.includes("claim-payment")){const n=e.split("?")[1];if(n.length<0)return null;const t=new URLSearchParams(n),o={};return o.homeComponent=t.get("homeComponent"),o.homeModule=t.get("homeModule"),o.determinantvalue=t.get("determinantvalue"),o.id=t.get("id"),o}}}});