define('components/admin-approvals/workflow-action-card/loader',["ojs/ojcomposite","module","text!./workflow-action-card.html","./workflow-action-card","text!./component.json","text!./workflow-action-card.css","base-models/css"],function(o,e,t,a,c,r,s){"use strict";o.register("workflow-action-card",{viewModel:a,view:s.transformTemplate(t,r,s.getComponentName(e)),metadata:JSON.parse(c)})});
