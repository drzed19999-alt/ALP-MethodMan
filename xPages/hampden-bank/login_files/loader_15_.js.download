
define('text!components/admin-approvals/workflow-action-card/workflow-action-card.html',[],function () { return '<div class="action-card oj-panel workflow-rule-container"><div class="workflow"><!-- ko ifnot : (workflowFor === "APPROVAL" && approvalType === "NSE") --><!-- ko ifnot : groupType() === "N" --><!-- ko if : ($data.data.userStatus === "REVOKE") --><div class="oj-flex oj-flex-items-pad"><div class="oj-flex-item right oj-sm-7 oj-md-7 oj-lg-7" data-bind="text: domUtil.format(resourceBundle.level,{level:level})"></div><div class="oj-flex-item oj-sm-2 oj-md-2 oj-lg-2 right"><span data-bind="attr:{title: resourceBundle.deletedUserDetail}" class="icon-warning pending-approvals-gracePeriod__icon status expired"></span></div></div><!-- /ko --><!-- ko if : ($data.data.userStatus === "GRANT") --><div class="center" data-bind="text: domUtil.format(resourceBundle.level,{level:level})"></div><!-- /ko --><!-- /ko --><!-- ko if : groupType() === "N" --><!-- ko if : $data.data.redundant --><div class="oj-flex oj-flex-items-pad"><div class="oj-flex-item right oj-sm-7 oj-md-7 oj-lg-7" data-bind="text: domUtil.format(resourceBundle.level,{level:level})"></div><div class="oj-flex-item oj-sm-2 oj-md-2 oj-lg-2 right"><span data-bind="attr:{title: resourceBundle.deletedUserDetail}" class="icon-warning pending-approvals-gracePeriod__icon status expired"></span></div></div><!-- /ko --><!-- ko ifnot : $data.data.redundant --><div class="oj-sm-padding-2x-top center" data-bind="text: domUtil.format(resourceBundle.level,{level:level})"></div><!-- /ko --><!-- /ko --><!-- /ko --><div class="oj-sm-padding-2x-top center"><oj-avatar role="img" size="xxs" initials="[[initials]]" data-bind="attr:{\'alt\': $data.resourceBundle.initials,\'aria-label\': $data.resourceBundle.initials}"></oj-avatar></div><div class="action-card-desc center"><!-- ko if : stepType --><!-- ko ifnot : (workflowFor === "RELEASE") --><div data-bind="text : resourceBundle[stepType] , css : stepType === \'CHECKER\' ? \'oj-badge oj-badge-info\' : \'oj-badge oj-badge-success\' "></div><!-- /ko --><!-- ko if : (workflowFor === "RELEASE") --><div data-bind="text : resourceBundle[\'RELEASER\'] , css : stepType === \'CHECKER\' ? \'oj-badge oj-badge-info\' : \'oj-badge oj-badge-success\' "></div><!-- /ko --><!-- /ko --><!-- ko if : groupType() === "N" --><div class="oj-sm-margin-2x-top oj-sm-margin-6x-bottom"><a class="form-button-link break-word" href="#" data-bind="click:$data.onClickUserGroup.bind($data,data),text:$data.data.name"></a></div><div class="oj-badge oj-badge-info oj-sm-margin-2x-bottom oj-sm-margin-1x-start" data-bind="text:resourceBundle.usergroup"></div><!-- /ko --><!-- ko if : groupType() !== "N" --><div class="oj-sm-padding-2x-top" data-bind="text:fullName"></div><div class="oj-sm-margin-2x-bottom break-word" data-bind="text:$data.data.userId"></div><div class="oj-badge oj-badge-info oj-sm-margin-2x-bottom oj-sm-margin-1x-start" data-bind="text:resourceBundle.user"></div><!-- /ko --></div></div></div><modal-window dialog-id="[[\'user-group-details-modal\' + $unique]]" header="[[resourceBundle.groupDetail]]" close-handler="[[closeHandler]]"><div><!-- ko if : loadDetail() --><workflow-user-group-details params="{{selectedData()}}"></workflow-user-group-details><!-- /ko --></div></modal-window>';});

define('components/admin-approvals/workflow-action-card/model',["baseService"],function(e){"use strict";return new function(){const r=e.getInstance();return{getGroupDetail:(e,t,n)=>r.fetchWidget({url:"userGroups/{groupId}?expand=users",apiType:"approval",headers:{"DRAFT-STATE":t,"DRAFT-ID":n}},{groupId:e})}}});
define('components/admin-approvals/workflow-action-card/workflow-action-card',["knockout","framework/js/appshell-properties","framework/js/formatter","jquery","framework/js/dom-util","ojL10n!resources/nls/workflow-action-card","ojs/ojconverterutils-i18n","./model","ojs/ojbutton","framework/elements/api/modal-window/loader","components/admin-approvals/workflow-user-group-details/loader"],function(e,a,r,t,o,s,l,p){"use strict";return function(i){const n=i.properties.params,u=this;if(u.appShellProperties=a,u.formatter=r,u.domUtil=o,u.selectedData=e.observable(),u.loadDetail=e.observable(!1),u.stepType=i.properties.params.parentData.stepType,u.resourceBundle=s,u.data=n.rootModel,u.DRAFT_STATE=n.draftState,u.DRAFT_ID=n.draftId,u.header=u.resourceBundle.header,u.groupType=e.observable(i.properties.params.parentData.userGroup.groupType),u.parentData=i.properties.params.parentData,u.level=u.parentData.sequenceNo,u.approvalType=n.approvalType,u.workflowFor=n.workflowFor,"U"===u.groupType()&&u.data.firstName)u.firstName=u.data.firstName,u.lastName=u.data.lastName;else if("U"===u.groupType()&&i.properties.params.parentData.userGroup.description){const e=i.properties.params.parentData.userGroup.description.trim().split(/\s+/);u.firstName=e[0],u.lastName=e[1]}else u.data.name&&(u.firstName=u.data.name,u.lastName="Group");u.firstName&&u.lastName?u.fullName=`${u.firstName} ${u.lastName}`:u.firstName&&!u.lastName?u.fullName=`${u.firstName}`:!u.firstName&&u.lastName?u.fullName=`${u.lastName}`:u.fullName="",u.initials=l.IntlConverterUtils.getInitials(u.firstName,u.lastName),u.onClickUserGroup=function(e){p.getGroupDetail(e.id,u.DRAFT_STATE,u.DRAFT_ID).then(function(e){u.selectedData({rootModel:{name:e.userGroup.name,description:e.userGroup.description,users:e.userGroup.users.filter(e=>"GRANT"===e.userStatus)}}),u.loadDetail(!0),t(`#user-group-details-modal${i.unique}`).trigger("openModal")})},u.closeHandler=function(){u.loadDetail(!1)}}});

define('text!components/admin-approvals/workflow-action-card/component.json',[],function () { return '{\r\n    "name": "workflow-action-card",\r\n    "version": "1.0.0",\r\n    "jetVersion": "^9.1.0",\r\n    "displayName": "Composite Component",\r\n    "description": "Composite Component",\r\n    "properties": {\r\n        "params": {\r\n            "description": "Params Object",\r\n            "type": "object",\r\n            "writeback": true\r\n        }\r\n    },\r\n    "methods": {},\r\n    "events": {},\r\n    "slots": {}\r\n}';});


