
define('text!framework/elements/api/account-lookup/account-lookup.html',[],function () { return '<oj-validation-group id="account-lookup-tracker"><oj-form-layout max-columns="[[domUtil.small() ? 1 : 2]]" direction="column" class="lr-padding" label-edge="top"><oj-input-text id="accountNumber" label-hint="[[locale.accountSelected]]" value="{{accountNumber}}" label-edge="provided"></oj-input-text><oj-combobox-one id="selectedBranch" label-hint="[[locale.branch]]" placeholder="[[locale.select]]" value="{{branch}}" label-edge="provided"><oj-bind-for-each data="[[branchList]]"><template><oj-option value="[[$current.data.id]]"><oj-bind-text value="[[$current.data.branchName]]"></oj-bind-text></oj-option></template></oj-bind-for-each></oj-combobox-one><oj-input-text id="accountName" label-hint="[[locale.accountName]]" value="{{accountName}}" validators="[[validation.getDomValidator.getValidator(\'NAME\')]]" label-edge="provided"></oj-input-text><oj-combobox-one id="selectedCurrency" label-hint="[[locale.currency]]" placeholder="[[locale.select]]" value="{{currency}}" label-edge="provided"><oj-bind-for-each data="[[currencyList]]"><template><oj-option value="[[$current.data.code]]"><oj-bind-text value="[[$current.data.code]]"></oj-bind-text></oj-option></template></oj-bind-for-each></oj-combobox-one></oj-form-layout></oj-validation-group><div class="button-container"><oj-button class="action-button-primary" chroming="callToAction" on-oj-action="[[fetchAccounts.bind($data, false)]]"><oj-bind-text value="[[locale.search]]"></oj-bind-text></oj-button><oj-button class="action-button-tertiary" chroming="borderless" on-oj-action="[[resetFilters]]"><oj-bind-text value="[[locale.clear]]"></oj-bind-text></oj-button></div><oj-bind-if test="[[tableDataFetched]]"><oj-table class="lr-padding" id="accountsTable" :aria-label="[[locale.accountsTable]]" data="[[dataprovider]]" columns=\'[[[{field: "accNumName", headerText: locale.accountNoAndName, width: !domUtil.large() ? "50%" : "auto", template: "accNumNameTemplate", sortProperty: "displayValue"}, {field: "accBranch", headerText:\n        locale.accountBranch, sortProperty: "branchCode"}, {field: "currency", headerText: locale.currency,\n        sortProperty: "currencyCode"}]]]\'><template slot="cellTemplate" data-oj-as="cell"><oj-bind-text value="[[cell.columnIndex === 1 ? cell.row.branchCode : cell.row.currencyCode]]"></oj-bind-text></template><template slot="accNumNameTemplate" data-oj-as="cell"><a href="#" data-bind="click: selectAccount.bind(null, cell.row), attr:{title: locale.selectAccount }"><oj-bind-text value="[[cell.row.displayValue]]"></oj-bind-text></a><oj-bind-if test="[[cell.row.displayName]]"><div><oj-bind-text value="[[cell.row.displayName]]"></oj-bind-text></div></oj-bind-if></template></oj-table></oj-bind-if><div class="button-container"><oj-button class="action-button-secondary" chroming="solid" on-oj-action="[[closeHandler]]"><oj-bind-text value="[[locale.cancel]]"></oj-bind-text></oj-button></div>';});

