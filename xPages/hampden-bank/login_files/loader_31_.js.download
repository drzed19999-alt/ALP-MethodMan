define('text!framework/elements/api/virtual-keyboard/component.json',[],function () { return '{\n    "name": "virtual-keyboard",\n    "version": "1.0.0",\n    "jetVersion": "^8.1.0",\n    "displayName": "Framework Composite Component",\n    "description": "Framework Composite Component",\n    "properties": {\n        "value": {\n            "description": "Value to Edit",\n            "type": "string",\n            "writeback": true,\n            "required": true\n        },\n        "inputLabel": {\n            "description": "label",\n            "type": "string"\n        },\n        "validators":{\n            "description": "input feild validator",\n            "type": "array"\n        },\n        "inputTitle": {\n            "description": "title",\n            "type": "string"\n        },\n        "password":{\n            "description": "attribute to dofferentiate if virtual keyboard required for password fiild or any other field",\n            "type": "boolean"\n        },\n        "maxLength":{\n            "description": "maximum allowed input characters",\n            "type": "number"\n        },\n        "onNullCheck":{\n            "description": "null checker",\n            "type": "function"\n        },\n        "required":{\n            "description": "This is the property to make required field as a optional attribute. Comsumer can choose based on their requirement",\n            "type": "boolean"\n        }\n    },\n    "methods": {},\n    "events": {},\n    "slots": {}\n}';});


define('text!framework/elements/api/virtual-keyboard/virtual-keyboard.css',[],function () { return '.virtual-keyboard-container .input-hint{font-size:var(--oj-user-assistance-inline-font-size)}.virtual-keyboard-container .keyboard{width:688px;margin:0;padding:0;list-style:none}.virtual-keyboard-container .keyboard li{float:left;margin:0 5px 5px 0;width:40px;height:40px;line-height:40px;text-align:center;border:1px solid var(--oj-core-divider-color);border-radius:5px}[dir=rtl] .virtual-keyboard-container .keyboard li{float:right;margin:0 0 5px 5px}.virtual-keyboard-container .keyboard li:hover{position:relative;top:1px;left:1px;cursor:pointer}.virtual-keyboard-container .keyboard .delete,.virtual-keyboard-container .keyboard .tab{width:70px}.virtual-keyboard-container .keyboard .capslock,.virtual-keyboard-container .keyboard .left-shift,.virtual-keyboard-container .keyboard .tab{clear:left}.virtual-keyboard-container .keyboard .capslock{width:80px}.virtual-keyboard-container .keyboard .return{width:77px}.virtual-keyboard-container .keyboard .left-shift{width:95px}.virtual-keyboard-container .keyboard .right-shift{width:109px}.virtual-keyboard-container .keyboard .lastitem{margin-right:0}.virtual-keyboard-container .keyboard .uppercase{text-transform:uppercase}.virtual-keyboard-container .keyboard .space{clear:left;width:681px}.virtual-keyboard-container .keyboard .on{display:none}';});

