
define('text!framework/elements/core/header/header.html',[],function () { return '<!-- ko if: !appData.isUserDataSet() && domUtil.large() --><entity-switch change-menu-state="[[$properties.changeMenuState]]"></entity-switch><!-- /ko --><!-- ko if: isHelpDeskSession() && appData.isUserDataSet() --><div class="oj-flex oj-flex-items-pad helpdesk-header-container"><div class="oj-flex-item oj-flex oj-md-10 helpdesk-header-container__title helpdesk-header-container-title"><span class="icons oj-ux-ico-contact"></span><h2 class="helpdesk-header-container-title__text" data-bind="text:domUtil.format(resourceBundle.topProfile.labels.helpDeskheading,{firstName:appData.userData.userProfile.firstName,lastName:appData.userData.userProfile.lastName})"></h2><span data-bind="text:domUtil.format(resourceBundle.topProfile.labels.helpDeskUserName,{userName:appData.userData.userProfile.userName})"></span></div><div class="oj-flex-item oj-md-2 helpdesk-header-container__icon right"><a href="#" class="oj-text-color-primary" data-bind="click: logOutHelpDeskSession,attr:{\'alt\':resourceBundle.topProfile.labels.logout ,\'aria-label\':resourceBundle.topProfile.labels.logout }"><span class="icons oj-ux-ico-close-circle"></span></a></div></div><!-- /ko --><!-- ko if: domUtil.large()  --><div class="oj-md-padding-3x-horizontal oj-flex-bar oj-sm-flex-1 oj-sm-padding-2x oj-web-applayout-header oj-sm-width-full"><div class="oj-flex-bar-start oj-sm-align-items-center"><!-- ko if : appShellProperties.menuNavigationAvailable && (domUtil.large() ? true : !appShellProperties.showMobileSearchBar()) --><oj-button chroming="borderless" display="icons" data-bind="attr:{\'aria-label\':resourceBundle.topProfile.labels.openMenu ,\'alt\':resourceBundle.topProfile.labels.toggleInner ,\'title\':resourceBundle.topProfile.labels.toggleInner },click:changeMenuState.bind(null, \'toggle\')"><span slot="startIcon" class="oj-ux-ico-menu"></span></oj-button><!-- /ko --><div class="icon-logo hamburger"><img class="oj-sm-padding-2x-top" placeholder-img="common/logo/logo-small.svg" data-bind="loadImage: `common/logo/logo${(appShellProperties.darkMode() ? \'-dark\': \'\') + (domUtil.small() ? \'-small\' : \'\')}.svg`, click:openDashboard, attr:{alt:resourceBundle.topProfile.labels.logo_alt, title:resourceBundle.topProfile.labels.logo_title} "/></div></div><!-- ko if: appShellProperties.showMobileSearchBar() --><div class="oj-flex-bar-middle oj-sm-justify-content-center oj-sm-align-self-center"><div class="oj-sm-width-4/5"><oj-input-search id="headerSearch" suggestions="[[searchSuggestions]]" value="{{searchKeyword}}" on-oj-value-action="[[searchSelectionChange]]" :placeholder="[[resourceBundle.topProfile.labels.search]]" :aria-label="[[resourceBundle.searchTransaction]]"></oj-input-search></div></div><!-- /ko --><div class="oj-flex-bar-end oj-sm-align-items-center gap"><!-- ko if: false --><div class="oj-flex-item"><oj-button chroming="borderless" display="icons" on-click="[[toggleSearchFieldDisplay]]"><span slot="startIcon" data-bind="css: appShellProperties.showMobileSearchBar() ? \'oj-ux-ico-close-circle-s\' : \'oj-ux-ico-search\' "></span><oj-bind-text value="[[resourceBundle.topProfile.labels.searchButton]]"></oj-bind-text></oj-button></div><!-- /ko --><!-- ko if: appData.isUserDataSet() && router.stateId() === "home" && appData.appData.segment !== "ADMIN"--><div class="oj-flex-item"><oj-menu-button display="icons" chroming="borderless"><span slot="endIcon" class="oj-ux-ico-settings"></span><oj-menu slot="menu" on-oj-menu-action="[[onGearClick]]" class="headerProfileMenu"><oj-bind-for-each data="[[personalizationMenuItems]]"><template><oj-option value="[[$current.data]]"><oj-bind-text value="[[resourceBundle.personalizationMenuOptions[$current.data]]]"></oj-bind-text></oj-option></template></oj-bind-for-each><!-- ko if:languageOptions().length > 1 --><oj-option><span data-bind="text:resourceBundle.language"></span><oj-menu><oj-bind-for-each data="[[languageOptions]]"><template><oj-option value="{{{type: \'LANG\', value: $current.data.value}}}"><span data-bind="text:$current.data.description"></span></oj-option></template></oj-bind-for-each></oj-menu></oj-option><!-- /ko --></oj-menu></oj-menu-button></div><!-- /ko --><!-- ko if: appData.isUserDataSet() --><!-- ko if: domUtil.large() && appShellProperties.menuNavigationAvailable --><div class="oj-flex-item"><oj-button id="mailbox-holder" display="icons" chroming="borderless" data-bind="attr:{\'alt\': resourceBundle.topProfile.labels.notificationAlt,\'title\':resourceBundle.topProfile.labels.notifications},click:openMailBox"><div slot="startIcon" class="oj-ux-ico-notification"><oj-bind-if test="[[totalMailboxCount()]]"><span class="oj-badge oj-badge-danger oj-badge-sm mailbox-badge" data-bind="text : totalMailboxCount()"></span></oj-bind-if></div></oj-button></div><!-- /ko --><div class="oj-flex-item oj-flex"><div class="oj-sm-padding-2x-end oj-sm-align-self-center oj-sm-text-align-end"><div class="oj-typography-body-sm oj-typography-bold" data-bind="text: currentParty()"></div><!-- ko ifnot: isSingleEntity() --><div class="oj-typography-body-xs" data-bind="text : currentEntity()"></div><!-- /ko --></div><oj-menu-button display="icons" chroming="borderless" class="oj-button-lg"><span slot="endIcon"><oj-avatar role="img" initials="[[avatarInitials]]" src size="xs" background="purple" :aria-label="[[appData.userData.userProfile.userName]]" :title="[[appData.userData.userProfile.userName]]"></oj-avatar></span><oj-menu slot="menu" on-oj-menu-action="[[profilePopupAction]]" class="headerProfileMenu"><oj-option><div class="oj-flex"><oj-avatar role="img" initials="[[avatarInitials]]" src size="xs" background="purple" :aria-label="[[appData.userData.userProfile.userName]]" :title="[[appData.userData.userProfile.userName]]"></oj-avatar><div class="oj-sm-padding-4x-horizontal oj-sm-align-self-center"><div class="oj-typography-body-sm oj-typography-semi-bold" data-bind="text : domUtil.format(resourceBundle.welcome,{firstName : appData.userData.userProfile.firstName, lastName : appData.userData.userProfile.lastName})"></div><div class="oj-typography-body-xs" data-bind="text : domUtil.format(resourceBundle.lastLogin,{lastLoginDate : formatter.getDomFormatter.formatDate(appData.userData.userProfile.preLastLoggedInDateTime,\'DATETIME\')})"></div></div></div></oj-option><oj-option id="divider"></oj-option><!-- ko if: appShellProperties.menuNavigationAvailable --><!-- ko if: entityList().length > 1 --><oj-option><span slot="startIcon" class="oj-ux-ico-domain"></span><oj-bind-text value="[[changeEntityLabel()]]"></oj-bind-text><oj-menu><oj-bind-for-each data="[[entityList]]"><template data-oj-as="item"><oj-option value="{{{type: isSingleEntity() ? \'PARTY\' : \'ENTITY\', value: item.data.value, entity: item.data.parentEntity}}}"><span data-bind="text:item.data.label"></span><!-- ko if: (appData.currentEntity === item.data.value) || (appData.currentParty === item.data.value)--> <span slot="startIcon" class="oj-ux-ico-check-circle-s"></span><!-- /ko --><!-- ko if: !isSingleEntity() && item?.data?.children && item.data.children.length  --><oj-menu><oj-bind-for-each data="[[item.data.children]]"><template data-oj-as="child"><oj-option value="{{{type: \'PARTY\', value: child.data.partyId.value, entity: item.data.value}}}"><span data-bind="text:child.data.relationshipType === \'B\' ? child.data.partyName : resourceBundle.personal"></span><!-- ko if: appData.currentParty === child.data.partyId.value  --> <span slot="startIcon" class="oj-ux-ico-check-circle-s"></span><!-- /ko --></oj-option></template></oj-bind-for-each></oj-menu><!-- /ko --></oj-option></template></oj-bind-for-each></oj-menu></oj-option><!-- /ko --><oj-option value="PROFILE"><span slot="startIcon" class="oj-ux-ico-avatar"></span><oj-bind-text value="[[resourceBundle.topProfile.labels.profile]]"></oj-bind-text></oj-option><!-- /ko --><oj-option value="LOGOUT"><span slot="startIcon" class="oj-ux-ico-power-on"></span><oj-bind-text value="[[resourceBundle.topProfile.labels.logout]]"></oj-bind-text></oj-option></oj-menu></oj-menu-button></div><!-- /ko --><!-- ko if: !appData.isUserDataSet() && appShellProperties.isDashboard() && appShellProperties.menuNavigationAvailable && domUtil.large() --><div class="oj-flex-item"><oj-button class="action-button-primary" chroming="callToAction" on-oj-action="[[login]]"><span data-bind="text : resourceBundle.topProfile.labels.login"></span></oj-button></div><!-- /ko --><oj-popup class="hide header-mailbox-launcher" id="popup1"><!-- ko if:loadMiniMailBox() --><mini-mailbox-admin class="mini-mailbox"></mini-mailbox-admin><!-- /ko --></oj-popup></div></div><!-- /ko --><!-- ko if: domUtil.small()  --><div class="oj-sm-padding-2x-top smallHeaderLayout"><div><div class="accounts_icons oj-sm-padding-3x-top leftIconLayout"><div><img class="icon-Size-Header" data-bind="loadImage: `dashboard/profile-settings.svg`, click:gotoProfile, attr:{alt:resourceBundle.topProfile.labels.logo_alt, title:resourceBundle.topProfile.labels.logo_title} "/></div><img class="leftIconDisplayNone" data-bind="loadImage:\'dashboard/profile-settings.svg\'"/></div></div><div><div class="accounts_icons oj-sm-padding-3x-top"><img class="icon-Size-Header-Logo" data-bind="loadImage:\'dashboard/small_logo.svg\'"/></div></div><div><div class="accounts_icons oj-sm-padding-3x-top rightIconLayout"><div><img class="icon-Size-Header" data-bind="loadImage: `dashboard/mail.svg`, click:gotoAlert, attr:{alt:resourceBundle.topProfile.labels.logo_alt, title:resourceBundle.topProfile.labels.logo_title} "/></div><div><img class="icon-Size-Header" data-bind="loadImage: `dashboard/notifications.svg`, click:gotoMail,  attr:{alt:resourceBundle.topProfile.labels.logo_alt, title:resourceBundle.topProfile.labels.logo_title} "/><oj-bind-if test="[[checkNotificationCount()]]"><span class="red-dot"></span></oj-bind-if></div></div></div></div><!-- /ko --><!-- ko ifnot: domUtil.large()  --><floating-panel panel-id="informationPopupHeader"><help params="transaction: appShellProperties.helpComponent.componentName"></help></floating-panel><!-- /ko --><modal-window dialog-id="RequestResetConfirmation" header="[[resourceBundle.resetConfirmationHeader]]"><div class="oj-sm-padding-2x-vertical"><span data-bind="text: $data.selectedGearOption() === \'RESETDASH\' ? resourceBundle.dashboardResetMsg : resourceBundle.layoutResetMsg"></span></div><div class="button-container"><oj-button class="action-button-primary" chroming="callToAction" on-click="[[gearResetConfirmed]]"><span data-bind="text:resourceBundle.confirm"></span></oj-button><oj-button class="action-button-secondary" chroming="solid" on-click="[[closeGearResetModal]]"><span data-bind="text:resourceBundle.cancel"></span></oj-button></div></modal-window><modal-window dialog-id="PreferredLanguage" header="[[resourceBundle.preferredLanguageHeader]]"><div><div data-bind="text:domUtil.format(resourceBundle.description,{language : $data.currentLanguage() ? $data.currentLanguage().description : null })"></div><div class="oj-flex"><div class="oj-flex-item oj-sm-margin-6x-top"><div class="button-container"><oj-button class="action-button-primary" chroming="callToAction" on-click="[[changePreferredLanguage]]"><span data-bind="text:resourceBundle.yes"></span></oj-button><oj-button class="action-button-secondary" chroming="solid" on-click="[[closePreferredLanguageModal]]"><span data-bind="text:resourceBundle.no"></span></oj-button></div></div></div></div></modal-window>';});

