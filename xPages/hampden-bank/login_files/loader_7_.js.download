define('text!framework/elements/api/modal-window/component.json',[],function () { return '{\n  "name": "modal-window",\n  "version": "1.0.0",\n  "jetVersion": "^8.1.0",\n  "displayName": "Framework Composite Component",\n  "description": "Framework Composite Component",\n  "properties": {\n    "dialogId": {\n      "description": "Dialog Id to be passed",\n      "type": "string",\n      "required": true\n    },\n    "header": {\n      "description": "Optional header",\n      "type": "string",\n      "required": false,\n      "translatable": true\n    },\n    "closeHandler": {\n      "description": "Close Handler function",\n      "type": "function"\n    },\n    "openHandler": {\n      "description": "Open Handler function",\n      "type": "function"\n    },\n    "hideHeader": {\n      "description": "Set false to hide header initially",\n      "type": "boolean",\n      "value": false\n    },\n    "display": {\n      "description": "Optional class name",\n      "type": "string",\n      "translatable": false\n    },\n    "modalWindowReady": {\n      "description": "Modal Window Ready Function",\n      "type": "function"\n    },\n    "icon": {\n      "description": "icon or image",\n      "type": "string"\n    }\n  },\n  "methods": {},\n  "events": {},\n  "slots": {\n    "body": {\n      "description": "Body Slot"\n    }\n  }\n}\n';});


