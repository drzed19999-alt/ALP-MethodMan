
define('text!framework/elements/core/entity-switch/entity-switch.html',[],function () { return '<div class="entity-switch oj-md-padding-3x-horizontal" :class="[[domUtil.large() ? \'oj-color-invert\' : \'\']]"><!-- ko if : appShellProperties.menuNavigationAvailable && appShellProperties.componentReset()--><!-- ko if: !domUtil.large() --><div><a class="form-button-link" href="#" id="MenuKebab343243" data-bind="click:$data.onClickMenuKebab,attr:{\'aria-label\':nls.kebab.MenuKebab,\'title\':nls.kebab.MenuKebab,id:\'menuLauncher-budget\'}"><span class="oj-ux-ico-overflow-v"></span></a><oj-menu open-options.display="[[\'dropDown\']]" :aria-label="[[nls.kebab.MoreActionsMenu]]" :title="[[nls.kebab.MoreActionsMenu]]" :id="[[\'menuLauncher-budget-container\']]" on-oj-action="[[kebabItemSelect]]" :open-options.launcher="[[\'menuLauncher-budget\']]" :open-options.display="[[\'dropDown\']]"><!-- ko foreach : {data : menuKebab,  as :\'contextData\', noChildContext: true }  --><oj-option value="[[contextData.id]]"><span data-bind="text:contextData.label"></span></oj-option><!-- /ko --></oj-menu></div><!-- ko if: entityListLoaded() --><div class="oj-flex oj-flex-items-pad"><div class="oj-flex-item oj-sm-align-self-center oj-sm-4 oj-md-4"><div data-bind="text:nls.entityHeader"></div></div><div class="oj-flex-item oj-sm-margin-3x-top oj-sm-8 oj-md-8"><oj-menu-button class="action-item" id="entity-switcher" :aria-label="[[domUtil.format(nls.entity.currentView,{currentEntity: currentEntity()})]]"><oj-bind-text value="[[currentEntity]]"></oj-bind-text><oj-menu id="myMenu" slot="menu" class="hide" on-oj-action="[[menuItemAction]]"><!-- ko foreach : entityList  --><oj-option value="{{$data.value}}"><span data-bind="text:$data.text"></span></oj-option><!-- /ko --></oj-menu></oj-menu-button></div></div><!-- /ko --><!-- /ko --><!-- ko if: domUtil.large() --><oj-toolbar id="defaultActions" class="pull-right"><oj-button class="action-item" id="ATMBRANCH" on-click="[[openATMBranch]]"><span data-bind="text:nls.atmBranch"></span></oj-button><!-- ko if:languageOptions().length > 0 --><oj-menu-button class="action-item" id="language-switcher" :aria-label="[[domUtil.format(nls.changeLanguage,{currentLanguage: currentLanguage()})]]"><oj-bind-text value="{{currentLanguage}}"></oj-bind-text><oj-menu id="languageMenu" slot="menu" class="hide" on-oj-action="[[switchLanguage]]"><!-- ko foreach : languageOptions  --><oj-option value="{{$data.code}}"><span data-bind="text:$data.description"></span></oj-option><!-- /ko --></oj-menu></oj-menu-button><!-- /ko --><!-- ko if: entityListLoaded() --><oj-menu-button class="action-item" id="entity-switcher" :aria-label="[[domUtil.format(nls.entity.currentView,{currentEntity: currentEntity()})]]"><oj-bind-text value="[[currentEntity]]"></oj-bind-text><oj-menu id="myMenu" slot="menu" class="hide" on-oj-action="[[menuItemAction]]"><!-- ko foreach : entityList  --><oj-option value="{{$data.value}}"><span data-bind="text:$data.text"></span></oj-option><!-- /ko --></oj-menu></oj-menu-button><!-- /ko --></oj-toolbar><!-- /ko --><!-- /ko --></div>';});

