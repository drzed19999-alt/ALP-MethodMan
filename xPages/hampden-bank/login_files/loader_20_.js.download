
define('text!framework/elements/api/account-input/account-input.html',[],function () { return '<!-- ko if: accountFetched() --><div><oj-bind-if test="[[!$properties.accountLookup]]"><oj-bind-if test="[[customInput]]"><div id="custom-account-select-input"><span class="oj-label" data-bind="text:label"></span><div class="my-custom-select-box"><oj-bind-if test="[[$properties.additionalDetails]]"><span class="custom-input-displayname oj-typography-body-xs oj-typography-bold" data-bind="text:$properties.additionalDetails.account.displayName"></span></oj-bind-if><oj-select-single placeholder="[[locale.selectAccount]]" minimum-results-for-search="1" required :id="[[id]]" :data-id="[[\'selectedAccount\']]" :readonly="[[readOnly]]" :class="[[$properties.classString]]" value="{{account}}" data="[[displayAccountList]]" user-assistance-density="[[userAssistanceDensity]]" class="display-size"><template slot="itemTemplate"><oj-option value="[[$current.data.value]]"><div class="oj-flex oj-sm-flex-items-initial oj-sm-justify-content-space-between oj-sm-align-items-center"><div class="oj-flex-item"><div class="oj-flex-bar"><span class="oj-flex-bar-start oj-sm-padding-2x-end oj-typography-body-xs oj-typography-bold" data-bind="text: $current.data.displayName"></span></div><div class="oj-flex-bar"><span class="oj-flex-bar-start oj-sm-padding-2x-end oj-typography-body-xs" data-bind="text: $current.data.id.displayValue"></span></div><oj-bind-if test="[[$current.data.availableBalance]]"><div class="oj-flex-bar oj-sm-margin-1x-top"><span class="oj-typography-body-xs select-option-amount-text" data-bind="text : formatter.getDomFormatter.formatCurrency($current.data.availableBalance.amount,$current.data.availableBalance.currency)"></span> <span class="oj-sm-margin-1x-horizontal oj-typography-body-xs select-option-currency-text" data-bind="text : \'(\'+$current.data.availableBalance.currency+\')\'"></span></div></oj-bind-if></div><div class="oj-flex-item"><oj-bind-if test="[[$properties.additionalDetails && ($current.data.id.value===$properties.additionalDetails.account.value)]]"><span class="oj-ux-ico-check"></span></oj-bind-if></div></div></oj-option></template></oj-select-single><oj-bind-if test="[[$properties.additionalDetails]]"><div class="custom-input-amount-display"><span class="oj-typography-body-xs select-option-amount-text" data-bind="text:formatter.getDomFormatter.formatCurrency($properties.additionalDetails.account.availableBalance.amount,$properties.additionalDetails.account.availableBalance.currency)"></span><span class="oj-typography-body-xs select-option-currency-text" data-bind="text : \'(\'+$properties.additionalDetails.account.availableBalance.currency+\')\'"></span></div></oj-bind-if></div></div></oj-bind-if><oj-bind-if test="[[!customInput]]"><oj-bind-if test="[[$properties.additionalDetails]]"><span class="custom-input-accountname oj-typography-body-xs oj-typography-bold" data-bind="text:$properties.additionalDetails.displayName"></span></oj-bind-if><oj-select-single placeholder="[[locale.selectAccount]]" minimum-results-for-search="1" required :id="[[id]]" :data-id="[[\'selectedAccount\']]" :readonly="[[readOnly]]" on-oj-value-action="[[$properties.ojValueAction]]" messages-custom="{{inlineInfoMessage}}" :class="[[$properties.classString]]" value="{{account}}" data="[[displayAccountList]]" user-assistance-density="[[userAssistanceDensity]]"><template slot="itemTemplate"><oj-option value="[[$current.data.value]]"><div class="oj-flex-bar"><span class="oj-flex-bar-start oj-sm-padding-2x-end" data-bind="text: $current.data.label"></span><!-- ko if: $current.data.status && $current.data.status !==\'ACTIVE\' --> <span class="oj-badge oj-badge-subtle oj-flex-bar-end" data-bind="text: $current.data.status"></span><!-- /ko --></div><!-- ko if: $current.data.accountDropdownDisplay --><div class="oj-flex-bar"><span class="oj-sm-margin-1x-top oj-typography-body-xs" data-bind="text : $current.data.accountDropdownDisplay"></span></div><!-- /ko --></oj-option></template></oj-select-single></oj-bind-if><!-- ko if : readOnly && selectedAccountDetails() --><div class="account-input__info-text" data-bind="text : selectedAccountDetails"></div><!-- /ko --></oj-bind-if><oj-bind-if test="[[$properties.accountLookup]]"><oj-input-text :id="[[$unique+\'lookUpAccount\']]" :data-id="[[\'selectedAccount\']]" class="accountDisplayName" value="[[accountDisplayName]]" label-hint="[[!hideLabel() ? label : locale.hideLabel]]" required translations=\'[[{\n          "required": {\n            "messageSummary": locale.accountRequiredSummary,  \n            "messageDetail": locale.accountRequiredDetail}}]]\' readonly="[[!!lookUpAccountDetails()]]" on-raw-value-changed="[[rawValueChanged]]" user-assistance-density="[[userAssistanceDensity]]" messages-custom="{{inlineInfoMessage}}"><oj-button display="icons" chroming="borderless" slot="end" on-click="[[openLookupPanel]]"><span slot="startIcon" class="icons oj-ux-ico-search"></span><oj-bind-text value="[[locale.lookupAccout]]"></oj-bind-text></oj-button></oj-input-text></oj-bind-if></div><!-- /ko -->';});

define('extensions/resources/nls/account-input',{root:{balanceNholding:"Balance : {balance}",noAccounts:"No Account(s) available",selectAccount:"Select an account",accountSelected:"Account Number",noAccountsmovemoney:"You do not have permissions to move money on this account. Please contact your account owner.",noAccountspayments:"You do not have permissions to set up payments on this account. Please contact your account owner.",accountLabel:"Source Account",displayContent:"{displayValue} - {nickname}",optGroup:"{id} - {name}",CON:"Conventional Account",ISL:"Islamic Account",RD:"Recurring Deposit",lookupAccout:"Look up Account",searchAccount:"Search Account",openLookup:"Open Lookup",txnNotAvailable:"This facility is not available for the selected account.",holdingPatternType:{SINGLE:"Single",JOINT:"Joint"},all:"All",hideLabel:""},ar:!1,fr:!0,cs:!1,sv:!1,en:!1,"en-us":!1,el:!1});

