define('text!framework/elements/api/account-input/component.json',[],function () { return '{\n  "name": "account-input",\n  "version": "1.0.0",\n  "jetVersion": "^8.1.0",\n  "displayName": "Framework Composite Component",\n  "description": "Framework Composite Component",\n  "properties": {\n    "accountsParser": {\n      "description": "Account Parser Function",\n      "type": "function"\n    },\n    "custom": {\n      "description": "Custom Account Input String",\n      "type": "boolean"\n    },\n    "ojValueAction":{\n      "description": "on value change Function",\n      "type": "function",\n      "required": false\n    },\n    "taskCode": {\n      "description": "Task Code",\n      "type": "string",\n      "writeback": true\n    },\n    "type": {\n      "description": "Additional Detail Type",\n      "type": "string",\n      "required": true\n    },\n    "accountType": {\n      "description": "Account Type",\n      "type": "array|string",\n      "required": true\n    },\n    "ddaAccountType": {\n      "description": "DDA Account Type",\n      "type": "array|string",\n      "required": false\n    },\n    "customUrl": {\n      "description": "Custom Url",\n      "type": "function",\n      "writeback": true,\n      "required": true\n    },\n    "account": {\n      "description": "Selected account number",\n      "type": "function",\n      "writeback": true,\n      "required": true\n    },\n    "partyId": {\n      "description": "Selected party id",\n      "type": "function",\n      "writeback": true,\n      "required": false\n    },\n    "classString": {\n      "description": "Class name to be binded to Oj Select",\n      "type": "string"\n    },\n    "readOnly": {\n      "description": "True to set Oj Select read only",\n      "type": "boolean"\n    },\n    "additionalDetails": {\n      "description": "Additional Details Object",\n      "type": "function",\n      "writeback": true\n    },\n    "label": {\n      "description": "Label",\n      "type": "string",\n      "translatable": true\n    },\n    "accountLookup": {\n      "description": "Flag to enable lookup",\n      "type": "boolean"\n    },\n    "showAll": {\n      "description": "Select All Account",\n      "type": "boolean"\n    },\n    "hideLabel": {\n      "description": "hide label",\n      "type": "boolean"\n    },\n    "readonlyAccount": {\n      "description": "read only account detail",\n      "type": "object"\n    }\n  },\n  "methods": {},\n  "events": {},\n  "slots": {}\n}';});


define('text!framework/elements/api/account-input/account-input.css',[],function () { return '.account-input-container .account-input__info-text{font-size:var(--oj-typography-body-sm-font-size);color:var(--oj-core-text-color-secondary);padding-bottom:.55rem}.account-input-container .my-custom-select-box{background-color:#fff!important;padding:3px 0 5px!important;border:1px solid #dcdcef!important;transition:border-color .1s linear;border-radius:8px!important}.account-input-container .my-custom-select-box .oj-required-inline-container{display:none}.account-input-container .my-custom-select-box .oj-user-assistance-inline-container{padding-left:8px;margin-top:-2px}.account-input-container .oj-text-field.oj-focus:not(.oj-read-only):not(.oj-invalid):not(.oj-warning) .oj-text-field-container{box-shadow:none}.account-input-container .my-custom-select-box .oj-text-field-container{border:none!important;background-color:transparent!important}.account-input-container .my-custom-select-box .oj-text-field-input{color:#443d66}.account-input-container .my-custom-select-box input.oj-text-field-input::placeholder{font-weight:500!important;color:#0056bb}.account-input-container .custom-input-label{color:#736d8c!important}.account-input-container .my-custom-select-box .custom-input-displayname{padding:0 var(--oj-text-field-text-to-edge-padding)!important;position:relative!important;top:10px!important}.account-input-container .my-custom-select-box .custom-input-amount-display{padding:0 var(--oj-text-field-text-to-edge-padding)!important;margin-top:-10px!important;margin-bottom:8px}.account-input-container .custom-input-accountname{position:relative!important;left:28px!important;top:33px!important;z-index:5!important}@media only screen and (max-width:767px){.account-input-container .my-custom-select-box .custom-input-displayname{font-size:.85rem!important}.account-input-container .display-size{font-size:.75rem!important;font-weight:600!important}.account-input-container .select-option-amount-text{font-size:.85rem!important;font-weight:700!important}.account-input-container .select-option-currency-text{font-size:.85rem!important}}';});

define('framework/elements/api/account-input/loader',["ojs/ojcomposite","module","text!./account-input.html","./account-input","text!./component.json","text!./account-input.css","base-models/css"],function(t,e,o,n,c,s,a){"use strict";t.register("account-input",{viewModel:n,view:a.transformTemplate(o,s,a.getComponentName(e)),metadata:JSON.parse(c)})});
