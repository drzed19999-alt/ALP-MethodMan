ainer .loginPopUp input[type=radio]{margin-right:0!important;margin-left:.6rem!important}[dir=ltr] .login-form-mobile-container .loginPopUp input[type=radio]{margin-right:.6rem!important}.login-form-mobile-container .loginPopUp .button-container{padding:1.6rem 0 0}.login-form-mobile-container .loginPopUp .mt30{margin-top:1.9rem}.login-form-mobile-container .loginPopUp .mt20{margin-top:1.3rem}.login-form-mobile-container .loginPopUp .mt15{margin-top:.9rem}.login-form-mobile-container .loginPopUp .margin-auto{margin:auto}.login-form-mobile-container .alert-msg,.login-form-mobile-container .danger{color:var(--base-color-danger)}.login-form-mobile-container .enable-finger-print{margin-top:.8rem}.login-form-mobile-container .extra-links .forgot-username-password{text-align:center}.login-form-mobile-container .extra-links .forgot-username-password .left-right-margin10{margin:1rem}.login-form-mobile-container .extra-links .alternateLoginPad{padding-top:.1rem}.login-form-mobile-container .extra-links .quickSnapshotLink{text-align:center;padding-top:1rem}.login-form-mobile-container .extra-links .alternateLoginLink{padding:1rem 0 .5rem;text-align:center;font-size:var(--oj-typography-body-lg-font-size)}.login-form-mobile-container .bgchanges{background-color:#fff;padding-top:.8rem}.login-form-mobile-container .quickSnapshotLinkFont{font-size:var(--oj-typography-body-lg-font-size)}.login-form-mobile-container .authenticationImage{width:10rem;height:5rem;padding:0 0 0 6rem}.login-form-mobile-container .authenticate{padding:.5rem 0 0 .5rem}.login-form-mobile-container .alternateLogin{padding:.5rem;text-align:right!important}[dir=rtl] .login-form-mobile-container .alternateLogin{text-align:right!important}.login-form-mobile-container .alternateSwitch{margin-top:.6rem}.login-form-mobile-container .login-enclosure__password{padding:.6rem 0}.login-form-mobile-container .login-enclosure .loginButton{width:225px;margin:.6rem 0}.login-form-mobile-container .login-enclosure__seperator{p