
define('text!components/login/login-form-mobile/login-form-mobile.html',[],function () { return '<!-- ko if: isPushoobAllowed() && notificationDataFetched() --><h4 class="center" data-bind="text: nls.loginForm.labels.authenticate"></h4><img class="authenticationImage" data-bind="loadImage : \'authentication/authentication.svg\'"><div class="oj-flex-item authenticate"><div class="oj-flex-items-pad quickSnapshotLinkFont" data-bind="text:nls.loginForm.labels.authenticateText"></div></div><div class="oj-flex-items-pad"><!-- ko foreach: displayData() --><obdx-row label="[[$data.key]]" value="[[$data.key === \'Amount\' ? $parents[$parents.length-1].formatter.getDomFormatter.formatCurrency($data.value.amount, $data.value.currency) : $data.value]]"></obdx-row><!-- /ko --></div><div class="oj-flex oj-flex-items-pad button-container"><oj-button class="action-button-primary" chroming="callToAction" display="icons" on-click="[[accept]]"><span class="icons oj-ux-ico-check-circle"></span><span data-bind="text:nls.loginForm.labels.confirm"></span></oj-button><oj-button class="action-button-secondary" chroming="solid" display="icons" on-click="[[reject]]"><span class="icons oj-ux-ico-close-circle"></span><span data-bind="text:nls.loginForm.labels.cancel"></span></oj-button></div><!-- /ko --><!-- ko ifnot: isPushoobAllowed() --><div class="bgchanges"><div data-bind="template: { name: \'login/login-form\'}"></div><div class="extra-links"><!-- ko ifnot:landingModule --><!-- ko if:domUtil.cordovaDevice()  && showAlternativeSwitch() --><div class="oj-flex alternateLoginPad"><div class="row oj-flex-item alternateLogin"><oj-label for="switch"><span data-bind="text:nls.loginForm.labels.enableAlternateLogin"></span></oj-label></div><div class="oj-flex-item alternateSwitch"><oj-switch id="switch" value="{{optForAlternateLogin}}"></oj-switch></div></div><!-- /ko --><!-- /ko --><!-- ko if: !(landingModule) || (landingComponent==="scan-qr") --><!-- ko if:domUtil.cordovaDevice()  && alternateLogin() --><div class="oj-flex-item alternateLoginLink"><a href="#" data-bind="click:openAlternateLogin"><span class="oj-flex-items-pad" data-bind="text:domUtil.format(nls.loginForm.labels.loginVia,{type:nls.loginForm.labels[alternateLogin().split(\'-\')[0]]})"></span></a></div><!-- /ko --><!-- /ko --><!-- ko if: snapshotRegistered() --><div class="oj-flex-item quickSnapshotLink"><oj-button class="action-button-tertiary" data-bind="click:onAugmentedRealitySnapshot"><span class="oj-flex-items-pad" data-bind="text:nls.loginForm.labels.augmentedRealitySnapshot"></span></oj-button></div><!-- /ko --><!-- ko if: domUtil.cordovaDevice()&&showAccountSnapshot() --><div class="oj-flex-item quickSnapshotLink"><oj-button href="#" on-click="[[onSnapshotClick]]" class="help-button" chroming="outlined"><span class="quickSnapshotLinkFont" data-bind="text:nls.loginForm.labels.quicksnapshot"></span></oj-button></div><!-- /ko --></div><!-- ko if:showAlternateLogin() --><alternate-login params="{{{rootModel:$data,type:alternateLogin()}}}"></alternate-login><!-- /ko --><!-- ko if:showLoginOptions() --><login-options params="{{{rootModel:$data,password:password}}}"></login-options><!-- /ko --><!-- ko if: domUtil.cordovaDevice()==="ANDROID"--><div class="oj-flex-item oj-lg-6-oj-md-6 oj-sm-12 oj-xl-6 popUpWindow"><modal-window class="message form-main-container" dialog-id="[[\'customPopupforPushNotification\']]" header="[[nls.loginForm.labels.push_window_title]]" close-handler="[[closeHandler]]" modal-window-ready="[[showDialog]]"><div class="oj-flex oj-flex-items-pad"><div class="oj-flex-item oj-sm-12"><span data-bind="text:nls.loginForm.labels.push_window_message"></span></div><div class="message-btn button-container confirm-dialog-container__button"><div class="oj-flex-item center oj-lg-10 oj-md-10"><oj-button class="form-button-primary" on-click="[[enablePush]]"><span data-bind="text:nls.loginForm.labels.allow"></span></oj-button><oj-button class="form-button-secondary" on-click="[[disablePush]]"><span data-bind="text:nls.loginForm.labels.disallow"></span></oj-button></div></div></div></modal-window></div><!-- /ko --><modal-window class="favorite-container" dialog-id="[[\'exitModal\']]" header="[[nls.loginForm.labels.exitApplication]]" close-handler="[[closeModal]]"><div><div class="oj-flex oj-flex-items-pad"><div class="oj-flex-item oj-sm-12" data-bind="text:nls.loginForm.labels.exitModal"></div></div><div class="button-container"><oj-button class="action-button-primary" chroming="callToAction" on-click="[[exitApplication]]"><span data-bind="text:nls.loginForm.labels.yes"></span></oj-button><oj-button class="action-button-secondary" chroming="solid" on-click="[[closeModal]]"><span data-bind="text:nls.loginForm.labels.no"></span></oj-button></div></div></modal-window><modal-window class="favorite-container" dialog-id="[[\'firstTimeLoginNotCompleted\']]" header="[[nls.loginForm.labels.sinceYouAreNewUser]]" close-handler="[[goToLoginPage]]"><div><div class="oj-flex-items-pad"><div data-bind="text:nls.loginForm.labels.sinceYouAreNewUser"></div></div><div class="button-container"><oj-button class="action-button-secondary" chroming="solid" on-click="[[goToLoginPage]]"><span data-bind="text:nls.loginForm.labels.ok"></span></oj-button></div></div></modal-window></div><!-- /ko -->';});

