define('text!components/login/login-form-mobile/login-form-mobile.css',[],function () { return '.login-form-mobile-container .loginContainer{position:fixed;top:0;overflow:auto;width:100%;height:100%;z-index:100;background:rgba(0,0,0,.4)}[dir=rtl] .login-form-mobile-container .loginContainer{right:0}[dir=ltr] .login-form-mobile-container .loginContainer{left:0}.login-form-mobile-container .loginContainer .forgotPassword{margin-top:.3rem}.login-form-mobile-container .loginContainer .loginFormContainer{display:block;height:auto;width:25rem;position:relative;top:9.4rem;background-color:var(--oj-panel-bg-color);padding:3.1rem}[dir=rtl] .login-form-mobile-container .loginContainer .loginFormContainer{right:6.3rem}[dir=ltr] .login-form-mobile-container .loginContainer .loginFormContainer{left:6.3rem}.login-form-mobile-container .loginContainer .loginFormContainer .loginInput input[type=password],.login-form-mobile-container .loginContainer .loginFormContainer .loginInput input[type=text]{width:80%}.login-form-mobile-container .loginContainer .loginFormContainer .login-logo{text-align:center}.login-form-mobile-container .loginContainer .loginFormContainer .login-logo img{width:12.5rem}.login-form-mobile-container .loginContainer .loginBox{width:100%;max-width:75rem}[dir=rtl] .login-form-mobile-container .loginContainer .loginBox{margin-right:auto}[dir=ltr] .login-form-mobile-container .loginContainer .loginBox,[dir=rtl] .login-form-mobile-container .loginContainer .loginBox{margin-left:auto}[dir=ltr] .login-form-mobile-container .loginContainer .loginBox{margin-right:auto}.login-form-mobile-container .loginContainer .loginHeader{padding:.9rem 1.3rem;background-color:var(--base-color-secondary);color:var(--color-white);height:3.8rem;box-sizing:border-box;font-size:var(--oj-typography-body-xl-font-size);font-weight:400}.login-form-mobile-container .loginContainer .icons{position:absolute;margin-top:.6rem}.login-form-mobile-container .loginContainer .loginButton{background-ima