
define('text!framework/elements/core/menu/menu.html',[],function () { return '<div><!-- ko if: iscorpUser() --><div class="oj-flex oj-flex-items-pad oj-sm-justify-content-center oj-sm-padding-10x-top oj-sm-padding-10x-bottom"><div class="icon-logo hamburger"><img placeholder-img="common/logo/Logo-Linear.svg" data-bind="loadImage: `common/logo/Logo-Linear.svg`, attr:{alt:nls.logo_alt} "></div></div><!-- /ko --><div class="oj-flex oj-flex-items-pad"><!-- ko if:!domUtil.large() --><!-- ko if: appData.isUserDataSet() --><!-- /ko --><!-- ko if: !appData.isUserDataSet() --><div class="oj-flex-item oj-sm-12 oj-sm-margin-5x-top"></div><!-- /ko --><!-- /ko --><!-- ko if: menuDrillMode() === "sliding" && !iscorpUser()--><oj-button display="icons" chroming="borderless" on-click=\'[[changeMenuState.bind(null,"toggle")]]\' class="oj-panel-remove-button"><span slot="endIcon" class="oj-panel-remove-icon"></span></oj-button><!-- /ko --></div><!-- ko if: !domUtil.large() --><!-- ko if: appData.isUserDataSet() --><!-- /ko --><!-- /ko --><!-- ko if: iscorpUser()--><oj-navigation-list class="oj-navigationlist-item-text-wrap" tabindex="-1" selection="{{selectedItem}}" drill-mode="none" on-selection-changed="[[optionChange]]" item.selectable="[[itemOnly]]" data-oj-context><ul data-bind="template: {name: \'menuTemplate\', foreach: listItem, as: \'item\'}"></ul><script type="text/html" id="menuTemplate"><li data-bind="attr: {id: $parents[$parents.length-1].domUtil.incrementIdCount()},css:$data.css"><a href="#" class="oj-sm-padding-1x-vertical" data-bind="attr:{\'alt\':$parents[$parents.length-1].nls.menu.groups[name]}"><!-- ko if:$data.icon--> <span class="oj-navigationlist-item-icon oj-sm-padding-5x-end" data-bind="css:$data.icon"></span><!-- /ko --><!-- ko text: $parents[$parents.length-1].nls.menu.groups[name] --><!-- /ko --><oj-bind-if test="[[$data.name==\'message-base\' && $parent.unreadNotificationCount()]]"><span class="red-dot"></span></oj-bind-if></a><!-- ko if: item.submenus --><ul data-bind="template: {name: \'menuTemplate\', foreach: item.submenus, as: \'item\', data : {name1 : $data.name}}"></ul><!-- /ko --></li></script><span id="divider" class="oj-disabled"></span></oj-navigation-list><!-- /ko --><!-- ko ifnot: iscorpUser()--><oj-navigation-list class="oj-navigationlist-item-text-wrap" root-label="[[nls.rootLabel]]" tabindex="-1" selection="{{selectedItem}}" drill-mode="[[menuDrillMode()]]" on-selection-changed="[[optionChange]]" item.selectable="[[itemOnly]]" data-oj-context><ul data-bind="template: {name: \'menuTemplate\', foreach: listItem, as: \'item\'}"></ul><script type="text/html" id="menuTemplate"><li data-bind="attr: {id: $parents[$parents.length-1].domUtil.incrementIdCount()},css:$data.css"><a href="#" class="oj-sm-padding-1x-vertical" data-bind="attr:{\'alt\':$parents[$parents.length-1].nls.menu.groups[name]}"><!-- ko if:$data.icon--> <span class="oj-navigationlist-item-icon oj-sm-padding-5x-end" data-bind="css:$data.icon"></span><!-- /ko --><!-- ko text: $parents[$parents.length-1].nls.menu.groups[name] --><!-- /ko --> </a><!-- ko if: item.submenus --><ul data-bind="template: {name: \'menuTemplate\', foreach: item.submenus, as: \'item\', data : {name1 : $data.name}}"></ul><!-- /ko --></li></script><span id="divider" class="oj-disabled"></span></oj-navigation-list><!-- /ko --><!-- ko if:iscorpUser() && !domUtil.small() --><div class="oj-flex oj-sm-padding-5x-start oj-sm-padding-5x-top oj-md-12"><oj-avatar role="img" shape="circle" initials="[[avatarInitials]]" src :size="[[domUtil.large()? \'xs\' : \'xxs\']]" background="pink" :aria-label="[[appData.appData.segment]]" :title="[[firstName]]" class="oj-md-2"></oj-avatar><div class="oj-md-10 text oj-sm-padding-4x-horizontal oj-sm-align-self-center oj-core-text-color-warning"><div class="oj-typography-body-sm" data-bind="text :firstName"></div><div class="oj-sm-align-self-center oj-sm-padding-1x-top"><div class="oj-flex"><span slot="endIcon" class="oj-ux-ico-log-out"></span> <a href="#" class="text oj-typography-body-sm oj-sm-padding-2x-start" data-bind=" click: logOutAction,attr,text :nls.signOut"></a></div></div></div></div><div class="oj-flex oj-sm-padding-5x-start oj-sm-padding-5x-top czLogout"><oj-avatar role="img" shape="circle" initials="[[avatarInitials]]" src size="xs" background="pink" :aria-label="[[appData.appData.segment]]" :title="[[firstName]]"></oj-avatar><div class="text oj-sm-padding-4x-horizontal oj-sm-align-self-center oj-core-text-color-warning"><div class="oj-typography-body-sm" data-bind="text :firstName"></div><div class="oj-sm-align-self-center oj-sm-padding-1x-top"><div class="oj-flex"><span slot="endIcon" class="oj-ux-ico-log-out"></span> <a href="#" class="text oj-typography-body-sm oj-sm-padding-2x-start" data-bind=" click: logOutAction,attr,text :nls.signOut"></a></div></div></div></div><!-- /ko --></div>';});

