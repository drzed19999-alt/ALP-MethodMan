
define('text!framework/elements/core/session-expiry-modal/session-expiry-modal.html',[],function () { return '<modal-window class="oj-flex oj-flex-items-pad message" dialog-id="[[\'sessionGettingExpired\']]" header="[[nls.sessionGettingExpiredHeader]]" open-handler="[[startSessionTimer]]" close-handler="[[sessionModalCloseHandler]]"><div><div class="oj-flex oj-sm-padding-3x-start oj-sm-padding-3x-top oj-lg-flex-wrap-nowrap"><div class="oj-flex-item oj-sm-only-justify-content-center"><oj-status-meter-gauge class="circular-status-meter-large" svg-class-name="circular-status-meter-svg" labelled-by="readOnly" inner-radius="0.9" min="0" max="{{sessionExpiryTimerStartBeforeInSec}}" value="{{sessionExpiryProgressValue}}" metric-label="{{sessionExpiryProgressTimer}}" orientation="circular" readonly="readonly"></oj-status-meter-gauge></div><div class="oj-flex-item oj-sm-margin-4x-start oj-sm-align-self-center" data-bind="text: isSessionExpired() ? nls.sessionExpired : nls.sessionGettingExpired"></div></div><div class="button-container"><!-- ko if: !isSessionExpired() --><oj-button id="stayConnectedButton" class="action-button-primary" chroming="callToAction" on-click="[[sessionGettingExpiredExtendHandler]]"><span data-bind="text:nls.extend"></span></oj-button><!-- /ko --><oj-button id="sessionExitButton" class="action-button-secondary" chroming="solid" on-click="[[logoutHandler]]"><span data-bind="text: isSessionExpired() ? nls.login : nls.logout"></span></oj-button></div></div></modal-window>';});


