# ── Server ──────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Security ─────────────────────────────────────────
# REQUIRED: Set this to a long random string in production
JWT_SECRET=change-this-to-a-secure-random-string

# ── Database (SQLite — local dev default) ────────────
# Path to the SQLite database file (relative to project root)
DB_PATH=./database/alp.db

# ── Database (Supabase — shared cloud DB) ────────────
# When these are set, Supabase is used instead of SQLite.
# Get these from: Supabase Dashboard → Project → Settings → API
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── CORS ─────────────────────────────────────────────
# Set to your domain in production, e.g. https://yourdomain.com
CORS_ORIGIN=*

# ── Telegram (optional) ──────────────────────────────
# Configure via the Settings page in the admin panel
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Domain Management — Cloudflare ───────────────────
# Required for the Domain Management module (Domains page)
# Option A — Scoped API Token (recommended if your plan supports Zone:Create)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone → Zone → Edit, Zone → DNS → Edit, Account → Zone → Edit
# CLOUDFLARE_API_TOKEN=

# Option B — Global API Key (works on all plans, use if Option A gives permission errors)
# Get at: https://dash.cloudflare.com/profile/api-tokens → "Global API Key" → View
# When using Global API Key, set BOTH vars below (leave Option A commented out):
# CLOUDFLARE_API_TOKEN=<your global api key>
# CLOUDFLARE_API_EMAIL=<your cloudflare account email>

# Optional — needed for zone quota display only
# Found at: https://dash.cloudflare.com → right sidebar → Account ID
# CLOUDFLARE_ACCOUNT_ID=

# ── Domain Management — Dry Run ──────────────────────
# Set to 'true' to simulate the full pipeline without real API calls
# Useful for testing the UI and state machine safely
# DOMAIN_DRY_RUN=false
