# ── Local Development ───────────────────────────────
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-this-to-a-secure-random-string
DB_PATH=./database/alp.db
CORS_ORIGIN=*

# ── Supabase (Vercel production) ────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Vercel Blob (file uploads & xPages) ─────────────
# Auto-provided by Vercel when you add Blob storage
BLOB_READ_WRITE_TOKEN=

# ── Telegram (optional) ────────────────────────────
# Set TELEGRAM_WEBHOOK_URL to your Vercel deployment URL for webhook mode
TELEGRAM_WEBHOOK_URL=
