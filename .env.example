# ── Server ──────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Security ─────────────────────────────────────────
# REQUIRED: Set this to a long random string in production
JWT_SECRET=change-this-to-a-secure-random-string

# ── Database (SQLite — local dev default) ────────────
# Path to the SQLite database file (relative to project root)
DB_PATH=./database/alp.db

# ── Database (Supabase — shared cloud DB) ────────────
# When these are set, Supabase is used instead of SQLite.
# Get these from: Supabase Dashboard → Project → Settings → API
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Sync tool (local → Railway DB sync) ──────────────
# Password of the admin account on the Railway deployment
RAILWAY_ADMIN_PASS=

# ── CORS ─────────────────────────────────────────────
# Set to your domain in production, e.g. https://yourdomain.com
CORS_ORIGIN=*

# ── Telegram (optional) ──────────────────────────────
# Configure via the Settings page in the admin panel
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
